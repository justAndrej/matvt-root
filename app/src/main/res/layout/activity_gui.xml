<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20.0dip">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:text="Service Status"
            android:textAlignment="center"
            android:textColor="#CA0000"
            android:textSize="20.0sp" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/gui_acc_perm"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility Permission"
            android:textAlignment="textStart"
            android:textSize="20.0sp" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/gui_acc_serv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility Service"
            android:textAlignment="textStart"
            android:textSize="20.0sp" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/gui_overlay_perm"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Overlay Permission"
            android:textAlignment="textStart"
            android:textSize="20.0sp" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/gui_overlay_serv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Overlay Service"
            android:textAlignment="textStart"
            android:textSize="20.0sp" />

        <Button
            android:id="@+id/gui_setup_perm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20.0dip"
            android:background="@drawable/button_background"
            android:nextFocusDown="@id/dsbar_mouse_size"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="SETUP PERMISSIONS"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:text="Other Settings"
            android:textAlignment="center"
            android:textColor="#CA0000"
            android:textSize="20.0sp" />


        <LinearLayout
            android:id="@+id/mouse_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cursor_size_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/dsbar_mouse_size"
                    android:textAlignment="textStart"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/cursor_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/cursor_preview_background"
                    android:contentDescription="@string/cursor_preview"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:padding="4dp"
                    android:scaleType="center" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/dsbar_mouse_size"
                style="@style/Widget.AppCompat.SeekBar.Discrete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:foregroundTint="@color/white"
                android:nextFocusUp="@id/gui_setup_perm"
                android:nextFocusDown="@id/sp_mouse_icon"
                android:progressBackgroundTint="@color/white_2"
                android:progressTint="@color/white"
                android:thumbTint="@color/white"
                android:tickMarkTint="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mouse_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:labelFor="@id/sp_mouse_icon"
                android:text="@string/cursor_style_label"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/sp_mouse_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawSelectorOnTop="true"
                android:dropDownWidth="match_parent"
                android:nextFocusUp="@id/dsbar_mouse_size"
                android:nextFocusDown="@id/cb_override"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_override"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:buttonTint="@color/white"
            android:layoutDirection="rtl"
            android:nextFocusUp="@id/sp_mouse_icon"
            android:nextFocusDown="@id/et_override"
            android:text="Override Activation Key"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <LinearLayout
            android:weightSum="1"
            android:orientation="horizontal"
            android:id="@+id/boss_override"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:inputType="number"
                android:hint="@string/activation_key_hint"
                android:id="@+id/et_override"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.20"
                android:nextFocusUp="@id/cb_override"
                android:nextFocusDown="@id/bt_override"
                android:nextFocusRight="@id/bt_override"
                android:singleLine="true"
                android:textColorHint="@color/white_2"
                android:buttonTint="@color/white"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/bt_override"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.80"
                android:background="@drawable/button_background"
                android:buttonTint="@color/white"
                android:nextFocusUp="@id/et_override"
                android:nextFocusLeft="@id/et_override"
                android:nextFocusDown="@id/density_enabled"
                android:text="SAVE"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/density_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/white"
            android:nextFocusUp="@id/bt_override"
            android:nextFocusDown="@id/density_dpi"
            android:text="@string/density_enabled"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/density_help"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/density_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@id/density_dpi"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/density_dpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/density_dpi_hint"
            android:inputType="number"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/density_enabled"
            android:nextFocusDown="@id/density_key"
            android:textColor="@color/white"
            android:textColorHint="@color/white_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/density_key"
            android:text="@string/density_key_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/density_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/density_key_hint"
            android:inputType="number"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/density_dpi"
            android:nextFocusDown="@id/density_detect"
            android:textColor="@color/white"
            android:textColorHint="@color/white_2" />

        <Button
            android:id="@+id/density_detect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:nextFocusUp="@id/density_key"
            android:nextFocusDown="@id/density_save"
            android:text="@string/density_detect"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/density_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:nextFocusUp="@id/density_detect"
            android:text="@string/density_save"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
